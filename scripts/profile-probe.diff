@@ -0,0 +1,286 @@
+//! PROFILING PROBE — worktree-only instrumentation, never to be landed.
+//!
+//! Counters for the **acceptance axis** (`Checker::new`, `th: None`), where no
+//! `Interp` exists and so `APP-SPINES.md`'s `kernel::Term`/`Thm` counters see
+//! nothing at all. Everything here is a thread-local `Cell`; the two census
+//! maps are behind `MINI_PROBE_CENSUS=1` because they are `O(term)` per entry.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+macro_rules! counters {
+    ($($n:ident),* $(,)?) => {
+        thread_local! {
+            $(pub static $n: Cell<u64> = const { Cell::new(0) };)*
+        }
+        pub fn reset() {
+            $($n.with(|c| c.set(0));)*
+            CENSUS.with(|m| m.borrow_mut().clear());
+            reset_adds();
+            WHNF_CENSUS.with(|m| m.borrow_mut().clear());
+        }
+        pub fn snapshot() -> Vec<(&'static str, u64)> {
+            vec![$((stringify!($n), $n.with(|c| c.get()))),*]
+        }
+    };
+}
+
+counters! {
+    INFER_ENTRIES,
+    INFER_INNER,
+    FRAME_HIT,
+    FRAME_MISS,
+    FRAME_STORE,
+    WHNF_CALLS,
+    WHNF_HIT,
+    WHNF_MISS,
+    WHNF_STEPS,
+    DEFEQ_CALLS,
+    DEFEQ_STRUCT,
+    DELTA_UNFOLD,
+    BETA_STEP,
+    IOTA_STEP,
+    EXPR_ALLOC,
+    EXPR_EQ_NODES,
+    SUBSTS_CALLS,
+    SUBSTS_NODES,
+    SHIFT_CALLS,
+    SHIFT_NODES,
+    HASH_NODES,
+    HASH_FMT,
+    INST_LPARAMS,
+    INTERN_HIT,
+    INTERN_MISS,
+    UNINTERNED_CHILD,
+}
+
+#[inline(always)]
+pub fn bump(c: &'static std::thread::LocalKey<Cell<u64>>) {
+    c.with(|x| x.set(x.get() + 1));
+}
+
+#[inline(always)]
+pub fn add(c: &'static std::thread::LocalKey<Cell<u64>>, n: u64) {
+    c.with(|x| x.set(x.get() + n));
+}
+
+thread_local! {
+    static ARMED: Cell<bool> = Cell::new(std::env::var_os("MINI_PROBE_CENSUS").is_some());
+    /// `infer_type` judgement key → times asked.
+    static CENSUS: RefCell<HashMap<(u64, u64), u64>> = RefCell::new(HashMap::new());
+    /// `whnf` subject key → times asked.
+    static WHNF_CENSUS: RefCell<HashMap<(u64, u64), u64>> = RefCell::new(HashMap::new());
+}
+
+pub fn armed() -> bool { ARMED.with(|a| a.get()) }
+
+thread_local! {
+    /// Experiment A: let the frame memo store `Typing`s whose evidence is a
+    /// `Gap` — i.e. every one, on the acceptance axis.
+    static FRAME_ALL: Cell<bool> = Cell::new(std::env::var_os("MINI_FRAME_ALL").is_some());
+    /// Experiment B: a frame-local `whnf` memo for acceptance-only calls.
+    static WHNF_MEMO: Cell<bool> = Cell::new(std::env::var_os("MINI_WHNF_MEMO").is_some());
+}
+
+thread_local! {
+    /// Experiment D: do not compute the memo key at all (`h = 0`). Sound
+    /// whenever the frame map is empty, which on the acceptance axis it always
+    /// is unless `MINI_FRAME_ALL` is also set.
+    static NO_HASH: Cell<bool> = Cell::new(std::env::var_os("MINI_NO_HASH").is_some());
+    /// Experiment G: a non-allocating FxHash-style key instead of SipHash +
+    /// `format!` per level.
+    static FAST_HASH: Cell<bool> = Cell::new(std::env::var_os("MINI_FASTHASH").is_some());
+}
+
+pub fn no_hash() -> bool { NO_HASH.with(|a| a.get()) }
+
+// ───────────────────────────── experiment H: hash-consing `Expr` ──
+//
+// `mk` routes every `Expr` allocation here when `MINI_INTERN` is set. The
+// intern table holds a strong `Rc` for every distinct node, so a pointer that
+// is in `HASHES` can never be reused for a different node while the run lives.
+
+use crate::expr::{Expr, E};
+
+thread_local! {
+    static INTERN_ON: Cell<bool> = Cell::new(std::env::var_os("MINI_INTERN").is_some());
+    static TABLE: RefCell<HashMap<u64, Vec<E>>> = RefCell::new(HashMap::new());
+    static HASHES: RefCell<HashMap<usize, u64>> = RefCell::new(HashMap::new());
+}
+
+pub fn intern_on() -> bool { INTERN_ON.with(|a| a.get()) }
+
+#[inline(always)]
+fn mix(a: u64, b: u64) -> u64 { (a ^ b).wrapping_mul(0x517c_c1b7_2722_0a95).rotate_left(26) }
+
+fn name_hash(n: &crate::expr::Name) -> u64 {
+    use crate::expr::Name;
+    match n {
+        Name::Anon => 5,
+        Name::Str(p, s) => {
+            let mut h = 6u64;
+            for b in s.as_bytes() {
+                h = mix(h, *b as u64);
+            }
+            mix(h, name_hash(p))
+        }
+        Name::Num(p, i) => mix(mix(7, *i), name_hash(p)),
+    }
+}
+
+fn level_hash(l: &crate::expr::Level) -> u64 {
+    use crate::expr::Level;
+    match l {
+        Level::Zero => 0,
+        Level::Succ(a) => mix(1, level_hash(a)),
+        Level::Max(a, b) => mix(mix(2, level_hash(a)), level_hash(b)),
+        Level::IMax(a, b) => mix(mix(3, level_hash(a)), level_hash(b)),
+        Level::Param(n) => mix(4, name_hash(n)),
+    }
+}
+
+/// The hash of an already-interned child, in O(1).
+fn child(e: &E) -> u64 {
+    let k = std::rc::Rc::as_ptr(e) as usize;
+    HASHES.with(|m| m.borrow().get(&k).copied()).unwrap_or_else(|| {
+        bump(&UNINTERNED_CHILD);
+        0
+    })
+}
+
+/// One node's hash from its children's — O(1), which is the whole point: a
+/// hash-consed representation pays for the key once, at construction.
+fn shallow(e: &Expr) -> u64 {
+    match e {
+        Expr::BVar(i) => mix(0, *i as u64),
+        Expr::Sort(u) => mix(1, level_hash(u)),
+        Expr::Const(n, ls) => {
+            let mut h = mix(2, name_hash(n));
+            for l in ls.iter() {
+                h = mix(h, level_hash(l));
+            }
+            h
+        }
+        Expr::App(f, a) => mix(mix(3, child(f)), child(a)),
+        Expr::Lam { ty, body } => mix(mix(4, child(ty)), child(body)),
+        Expr::Forall { ty, body } => mix(mix(5, child(ty)), child(body)),
+        Expr::Let { ty, val, body } => mix(mix(mix(6, child(ty)), child(val)), child(body)),
+        Expr::Proj { ind, idx, s } => mix(mix(mix(7, name_hash(ind)), *idx as u64), child(s)),
+        Expr::NatLit(n) => mix(8, *n),
+        Expr::StrLit(s) => {
+            let mut h = 9u64;
+            for b in s.as_bytes() {
+                h = mix(h, *b as u64);
+            }
+            h
+        }
+    }
+}
+
+pub fn intern(e: Expr) -> E {
+    let h = shallow(&e);
+    let hit = TABLE.with(|t| {
+        t.borrow().get(&h).and_then(|v| v.iter().find(|c| ***c == e).cloned())
+    });
+    if let Some(c) = hit {
+        bump(&INTERN_HIT);
+        return c
+    }
+    bump(&INTERN_MISS);
+    let rc: E = std::rc::Rc::new(e);
+    HASHES.with(|m| m.borrow_mut().insert(std::rc::Rc::as_ptr(&rc) as usize, h));
+    TABLE.with(|t| t.borrow_mut().entry(h).or_default().push(rc.clone()));
+    rc
+}
+
+pub fn intern_size() -> usize { TABLE.with(|t| t.borrow().values().map(|v| v.len()).sum()) }
+pub fn fast_hash() -> bool { FAST_HASH.with(|a| a.get()) }
+
+pub fn frame_all() -> bool { FRAME_ALL.with(|a| a.get()) }
+pub fn whnf_memo() -> bool { WHNF_MEMO.with(|a| a.get()) }
+
+thread_local! {
+    static ADD_DEPTH: Cell<u32> = const { Cell::new(0) };
+    static ADD_NANOS: Cell<u128> = const { Cell::new(0) };
+    static ADD_ROWS: RefCell<Vec<(String, f64, u64)>> = RefCell::new(Vec::new());
+}
+
+/// RAII guard around one **outermost** `kernel::add`.
+pub struct AddGuard(Option<std::time::Instant>, String);
+
+pub fn add_enter(name: String) -> AddGuard {
+    let d = ADD_DEPTH.with(|c| { let v = c.get(); c.set(v + 1); v });
+    AddGuard(if d == 0 { Some(std::time::Instant::now()) } else { None }, name)
+}
+
+impl Drop for AddGuard {
+    fn drop(&mut self) {
+        ADD_DEPTH.with(|c| c.set(c.get() - 1));
+        if let Some(t) = self.0 {
+            let dt = t.elapsed();
+            ADD_NANOS.with(|c| c.set(c.get() + dt.as_nanos()));
+            let n = INFER_ENTRIES.with(|c| c.get());
+            ADD_ROWS.with(|r| r.borrow_mut().push((self.1.clone(), dt.as_secs_f64(), n)));
+        }
+    }
+}
+
+pub fn add_secs() -> f64 { ADD_NANOS.with(|c| c.get()) as f64 / 1e9 }
+
+pub fn add_rows() -> Vec<(String, f64, u64)> { ADD_ROWS.with(|r| r.borrow().clone()) }
+
+pub fn reset_adds() {
+    ADD_NANOS.with(|c| c.set(0));
+    ADD_ROWS.with(|r| r.borrow_mut().clear());
+}
+
+pub fn note_infer(lenv: u64, e: u64) {
+    if !armed() {
+        return
+    }
+    CENSUS.with(|m| *m.borrow_mut().entry((lenv, e)).or_insert(0) += 1);
+}
+
+pub fn note_whnf(lenv: u64, e: u64) {
+    if !armed() {
+        return
+    }
+    WHNF_CENSUS.with(|m| *m.borrow_mut().entry((lenv, e)).or_insert(0) += 1);
+}
+
+fn census_line(name: &str, m: &HashMap<(u64, u64), u64>) -> String {
+    let total: u64 = m.values().sum();
+    let distinct = m.len() as u64;
+    // Distinct expressions ignoring the telescope — what a memo keyed on the
+    // expression alone, across openings, could collapse to.
+    let mut by_expr: HashMap<u64, u64> = HashMap::new();
+    for ((_, e), n) in m {
+        *by_expr.entry(*e).or_insert(0) += n;
+    }
+    let top = m.values().copied().max().unwrap_or(0);
+    format!(
+        "{name}: total={total} distinct(lenv,e)={distinct} distinct(e)={} \
+         dup={:.1}x pct_distinct={:.3}% max_repeat={top}",
+        by_expr.len(),
+        if distinct == 0 { 0.0 } else { total as f64 / distinct as f64 },
+        if total == 0 { 0.0 } else { 100.0 * distinct as f64 / total as f64 },
+    )
+}
+
+pub fn report(tag: &str) {
+    let s = snapshot();
+    let mut parts = Vec::new();
+    for (n, v) in &s {
+        if *v != 0 {
+            parts.push(format!("{n}={v}"));
+        }
+    }
+    println!("PROBE [{tag}] {}", parts.join(" "));
+    if intern_on() {
+        println!("PROBE [{tag}] intern_distinct={}", intern_size());
+    }
+    if armed() {
+        CENSUS.with(|m| println!("PROBE [{tag}] {}", census_line("infer", &m.borrow())));
+        WHNF_CENSUS.with(|m| println!("PROBE [{tag}] {}", census_line("whnf", &m.borrow())));
+    }
+}
