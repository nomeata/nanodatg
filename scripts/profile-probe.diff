diff --git a/mini/examples/tower.rs b/mini/examples/tower.rs
new file mode 100644
index 0000000..a0e08e4
--- /dev/null
+++ b/mini/examples/tower.rs
@@ -0,0 +1,125 @@
+//! PROFILING PROBE — not for landing. The acceptance axis, timed and split.
+//!
+//! `tower <fixture-name>…` loads each fixture with `--nested` semantics and,
+//! for every nested inductive in it, times
+//!
+//!   * `nested::plan`      — the shape analysis;
+//!   * `nested_ev::iso`    — tower generation *and* every `kernel::add` inside
+//!                           it (the generator checks everything it emits);
+//!   * `kernel::add(d)`    — zone A's own acceptance of the export declaration.
+//!
+//! No `Interp` is constructed anywhere on this path, so nothing below touches
+//! `kernel::Term` or `kernel::Thm`.
+
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use mini::convert::{load_with, LoadOptions};
+use mini::env::{Declaration, Environment};
+use mini::expr::{Expr, E};
+
+fn fixture(name: &str) -> PathBuf {
+    if name.ends_with(".ndjson") {
+        return PathBuf::from(name)
+    }
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures").join(format!("{name}.ndjson"))
+}
+
+/// Expression nodes, counted as a tree (no DAG sharing) — the axis
+/// MEASUREMENTS.md's tower table uses.
+fn nodes(e: &E) -> u64 {
+    1 + match &**e {
+        Expr::App(f, a) => nodes(f) + nodes(a),
+        Expr::Lam { ty, body } | Expr::Forall { ty, body } => nodes(ty) + nodes(body),
+        Expr::Let { ty, val, body } => nodes(ty) + nodes(val) + nodes(body),
+        Expr::Proj { s, .. } => nodes(s),
+        _ => 0,
+    }
+}
+
+fn decl_nodes(d: &Declaration) -> u64 {
+    match d {
+        Declaration::Axiom { ty, .. } => nodes(ty),
+        Declaration::Def { ty, value, .. } => nodes(ty) + nodes(value),
+        Declaration::Quot => 0,
+        Declaration::Inductive { ty, ctors, .. } => {
+            nodes(ty) + ctors.iter().map(|(_, t)| nodes(t)).sum::<u64>()
+        }
+        Declaration::Mutual { types, .. } => types
+            .iter()
+            .map(|t| nodes(&t.ty) + t.ctors.iter().map(|(_, c)| nodes(c)).sum::<u64>())
+            .sum(),
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let opts = LoadOptions { nested: true, mutual: true, ..Default::default() };
+    for f in &args {
+        let loaded = load_with(&fixture(f), opts).expect("load");
+        let mut env = Environment::empty();
+        let mut export_add = 0f64;
+        for d in &loaded.decls {
+            if let Declaration::Inductive { name, lparams, num_params, ty, ctors } = d {
+                let types = vec![mini::env::IndType {
+                    name: name.clone(),
+                    ty: ty.clone(),
+                    ctors: ctors.clone(),
+                }];
+                let t0 = Instant::now();
+                let plan = mini::nested::plan(&env, lparams, *num_params, &types);
+                let t_plan = t0.elapsed().as_secs_f64();
+                if let Ok(Some(plan)) = plan {
+                    mini::probe::reset();
+                    let t1 = Instant::now();
+                    let r = mini::nested_ev::iso(&env, lparams, *num_params, &types, &plan);
+                    let t_iso = t1.elapsed().as_secs_f64();
+                    let mut sizes: std::collections::HashMap<String, u64> =
+                        std::collections::HashMap::new();
+                    let (k, n) = match &r {
+                        Ok(iso) => {
+                            for d in &iso.decls {
+                                sizes.insert(d.name().to_string(), decl_nodes(d));
+                            }
+                            (iso.decls.len(), iso.decls.iter().map(decl_nodes).sum::<u64>())
+                        }
+                        Err(e) => {
+                            println!("{f}/{name}: declined {}", e.label());
+                            continue
+                        }
+                    };
+                    let t_add = mini::probe::add_secs();
+                    println!(
+                        "ISO {f}/{name} plan={t_plan:.3}s iso={t_iso:.3}s add={t_add:.3}s \
+                         gen={:.3}s decls={k} nodes={n}",
+                        t_iso - t_add
+                    );
+                    let mut rows = mini::probe::add_rows();
+                    rows.sort_by(|a, b| b.1.total_cmp(&a.1));
+                    let mut prev = 0u64;
+                    let mut byname: Vec<(String, f64, u64)> = Vec::new();
+                    for (nm, dt, cum) in mini::probe::add_rows() {
+                        byname.push((nm, dt, cum - prev));
+                        prev = cum;
+                    }
+                    byname.sort_by(|a, b| b.1.total_cmp(&a.1));
+                    for (nm, dt, infers) in byname.iter() {
+                        let sz = sizes.get(nm).copied().unwrap_or(0);
+                        println!("  ADD-IN-ISO {nm} {dt:.4}s infer={infers} nodes={sz}");
+                    }
+                    mini::probe::report(&format!("{f}/{name}"));
+                }
+            }
+            mini::probe::reset();
+            let t2 = Instant::now();
+            mini::kernel::add(&mut env, d).unwrap_or_else(|e| panic!("{}: {e}", d.name()));
+            let dt = t2.elapsed().as_secs_f64();
+            export_add += dt;
+            if dt > 0.05 {
+                println!("ADD {f}/{} {dt:.3}s nodes={}", d.name(), decl_nodes(d));
+                mini::probe::report(&format!("add {}", d.name()));
+            }
+        }
+        println!("EXPORT-ADD {f} total={export_add:.3}s");
+    }
+}
