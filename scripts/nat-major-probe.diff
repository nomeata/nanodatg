         use NatBinOp::*;
         let (x, y) = (self.whnf(x), self.whnf(y));
@@ -627,8 +630,31 @@ impl<'x, 't: 'x, 'p: 't> TypeChecker<'x, 't, 'p> {
             XOr => self.ctx.mk_nat_lit_quick(nat_xor(&arg1, &arg2)),
             Shl => self.ctx.mk_nat_lit_quick(nat_shl(arg1, arg2)),
