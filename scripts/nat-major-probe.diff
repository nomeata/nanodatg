+            // PROBE (uncommitted): withhold the acceleration at SMALL operands,
+            // so the comparison unfolds structurally and the backend can see it.
+            // `NANODA_NAT_CMP_MIN=n`: accelerate only when max(a,b) >= n.
+            Beq | Ble => {
+                static MIN: std::sync::OnceLock<Option<num_bigint::BigUint>> = std::sync::OnceLock::new();
+                let m = MIN.get_or_init(|| {
+                    std::env::var("NANODA_NAT_CMP_MIN").ok().and_then(|s| s.parse::<u64>().ok()).map(num_bigint::BigUint::from)
+                });
+                if let Some(m) = m {
+                    if &arg1 < m && &arg2 < m {
+                        return None
+                    }
+                }
+                {
+                    let bits = arg1.bits().max(arg2.bits());
+                    let b = if bits <= 4 { 0 } else if bits <= 8 { 1 } else if bits <= 16 { 2 }
+                            else if bits <= 32 { 3 } else if bits <= 64 { 4 } else { 5 };
+                    crate::tc::CMP_BITS[b].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                }
+                if matches!(op, Beq) {
+                    self.ctx.bool_to_expr(arg1 == arg2)
+                } else {
+                    self.ctx.bool_to_expr(arg1 <= arg2)
+                }
+            }
         }
     }
     
@@ -2884,3 +2910,17 @@ impl<'x, 't: 'x, 'p: 't> TypeChecker<'x, 't, 'p> {
         None
     }
 }
+
+// PROBE (uncommitted): the operand size distribution of every accelerated
+// Nat comparison the checker performs, bucketed by bit width.
+pub static CMP_BITS: [std::sync::atomic::AtomicU64; 6] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 6];
+pub fn cmp_bits_report() -> String {
+    use std::sync::atomic::Ordering::Relaxed;
+    let l = ["<=4 bits", "<=8", "<=16", "<=32", "<=64", ">64"];
+    let mut s = String::from("  PROBE: accelerated Nat.beq/ble by operand bit width\n");
+    for (i, n) in l.iter().enumerate() {
+        s.push_str(&format!("    {n:<76}  {:>8}\n", CMP_BITS[i].load(Relaxed)));
+    }
+    s
+}
