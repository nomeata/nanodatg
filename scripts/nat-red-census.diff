     pub(crate) fn admit(&mut self, x: ExprPtr<'t>, y: ExprPtr<'t>, site: Admit) -> DefEq<'t, 'p> {
         crate::certify::bump_admit(site);
+        // ── PROBE (task #128 census, worktree only) ──────────────────────────
+        // Every `Admit::NatRed` the checker is asked about, split by the head
+        // constant and by whether both operands are already numeral literals.
+        // `derived::nat::ble_transfer` serves exactly `Nat.ble` at two numerals,
+        // so this says what fraction of the population the construction reaches
+        // before it is wired.
+        #[cfg(feature = "stepcount")]
+        if matches!(site, Admit::NatRed) {
+            let (f, args) = self.ctx.unfold_apps(x);
+            let head = match self.ctx.read_expr(f) {
+                Const { name, .. } => {
+                    fn go<'t, 'p>(ctx: &TcCtx<'t, 'p>, n: crate::util::NamePtr<'t>, out: &mut String) {
+                        match ctx.read_name(n) {
+                            crate::name::Name::Anon => {}
+                            crate::name::Name::Str(pre, sfx, _) => {
+                                go(ctx, pre, out);
+                                if !out.is_empty() {
+                                    out.push('.');
+                                }
+                                out.push_str(ctx.read_string(sfx).as_ref());
+                            }
+                            crate::name::Name::Num(pre, i, _) => {
+                                go(ctx, pre, out);
+                                if !out.is_empty() {
+                                    out.push('.');
+                                }
+                                out.push_str(&i.to_string());
+                            }
+                        }
+                    }
+                    let mut buf = String::new();
+                    go(self.ctx, name, &mut buf);
+                    buf
+                }
+                _ => "<not a constant>".to_string(),
+            };
+            let lit = |e: crate::util::ExprPtr<'t>| -> Option<u64> {
+                match self.ctx.read_expr(e) {
+                    crate::expr::Expr::NatLit { ptr, .. } => {
+                        self.ctx.read_bignum(ptr).and_then(|b| u64::try_from(b).ok())
+                    }
+                    _ => None,
+                }
+            };
+            let shape = match args.as_slice() {
+                [a] => match lit(*a) {
+                    Some(_) => "1 numeral",
+                    None => "1 NON-numeral",
+                },
+                [a, b] => match (lit(*a), lit(*b)) {
+                    (Some(_), Some(_)) => "2 numerals",
+                    _ => "2 args, NOT both numerals",
+                },
+                _ => "other arity",
+            };
