+                    13..=255 => "max<=255".to_string(),
+                    _ => "max>255".to_string(),
+                });
+            let mut g = crate::tc::NAT_RED_CENSUS.lock().expect("nat census poisoned");
+            *g.entry(format!("{head:<24} {shape:<26} {big}")).or_insert(0u64) += 1;
+        }
         Some(self.certifier.admit(self.ctx, x, y, site.name()))
     }
 
