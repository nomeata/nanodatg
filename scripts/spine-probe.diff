+        if self.exprs_rev.contains_key(&head) {
+            SP_ATOM_NODE.fetch_add(1, Relaxed);
+        }
+        if args.iter().all(|a| self.exprs_rev.contains_key(a)) {
+            SP_ARGS_NODE.fetch_add(1, Relaxed);
+        }
+
+        // What the thread already holds. `dprods` is the set of head symbols any
+        // `⟦Π⟧` interprets through, so "the recorded target is a dependent
+        // product" is a symbol test rather than a guess.
+        let sh = self.shared.borrow();
+        let is_dprod = |t: &Term| -> bool {
+            t.as_app().is_some_and(|(f, _)| sh.pi_infos.values().any(|i| i.dprod == f))
+        };
+        let fs = self.pre.fs_sym();
+        if sh.typed_at.contains_key(&(x.clone(), dom.clone())) {
+            SP_FACTS[0].fetch_add(1, Relaxed);
+        }
+        if sh.typed_subj.contains_key(x) {
+            SP_FACTS[1].fetch_add(1, Relaxed);
+        }
+        let hd = x.as_app().map(|(_, a)| a[0].clone());
+        if hd.as_ref().is_some_and(|h| sh.typed_subj.contains_key(h)) {
+            SP_FACTS[2].fetch_add(1, Relaxed);
+        }
+        if sh.typed_subj.contains_key(&head) {
+            SP_FACTS[3].fetch_add(1, Relaxed);
+        }
+        if !args.is_empty() && args.iter().all(|a| sh.typed_subj.contains_key(a)) {
+            SP_FACTS[4].fetch_add(1, Relaxed);
+        }
+        // The immediate head's recorded target, which is what decides whether
+        // `fs_app_mem` (or the dependent-product rule) would conclude the very
+        // claim being asked.
+        let hd_ty = hd.as_ref().and_then(|h| sh.typed_subj_ty.get(h).cloned());
+        let hd_class = match &hd_ty {
+            None => 4,
+            Some(t) => match t.as_app() {
+                Some((f, a)) if f == fs && a.len() == 2 => {
+                    if a[1] == *dom {
