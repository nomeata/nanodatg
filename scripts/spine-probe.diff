+            let (h, arg) = (a[0].clone(), a[1].clone());
+            args.push(arg);
+            head = h;
+        }
+        args.reverse();
+        let k = args.len();
+        SP_LEN[k.min(7)].fetch_add(1, Relaxed);
+
+        // What the atom head is.
+        let atom_class = match head.as_app() {
+            None => 3, // a free variable
+            Some((sym, _)) => {
+                if self.core.lams().borrow().by_lam(sym).is_some() {
+                    0 // a λ graph
+                } else if self.abbrev_defs.contains_key(&head) {
+                    1 // a defined constant, with an equation
+                } else {
+                    2 // an opaque symbol
+                }
