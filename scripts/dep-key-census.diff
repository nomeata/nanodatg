+#[cfg(feature = "stepcount")]
+static DEP_KEYS: std::sync::Mutex<Option<std::collections::BTreeMap<&'static str, (u64, std::collections::HashSet<u64>)>>> =
+    std::sync::Mutex::new(None);
+
+#[cfg(feature = "stepcount")]
+fn dep_key_note(what: &'static str, h: u64) {
+    let mut g = DEP_KEYS.lock().expect("dep key census poisoned");
+    let m = g.get_or_insert_with(Default::default);
+    let e = m.entry(what).or_default();
+    e.0 += 1;
+    e.1.insert(h);
+}
+
+#[cfg(feature = "stepcount")]
+fn dep_key_hash<T: std::hash::Hash>(x: &T) -> u64 {
+    use std::hash::Hasher;
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    x.hash(&mut h);
+    h.finish()
+}
+
+#[cfg(feature = "stepcount")]
+fn dep_key_report() -> String {
+    let g = DEP_KEYS.lock().expect("dep key census poisoned");
+    let Some(m) = g.as_ref() else { return String::new() };
+    let mut s = String::from("  PROBE — dependent ι key census (paid / distinct):\n");
+    for (k, (n, set)) in m {
+        s.push_str(&format!("    {k:<52}  {n:>8} / {:>8}\n", set.len()));
+    }
+    s
+}
