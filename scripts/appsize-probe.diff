diff --git a/mini/src/termstats.rs b/mini/src/termstats.rs
new file mode 100644
index 0000000..723ee67
--- /dev/null
+++ b/mini/src/termstats.rs
@@ -0,0 +1,261 @@
+//! MEASUREMENT PROBE — appsize study, worktree-only, never to be landed.
+//!
+//! Term-node and inference-count statistics for the `app`-spine study. The
+//! walker reads the interpretation store after a run; the counters are
+//! accumulated by thin wrappers in `interp.rs` / `conv.rs` / `kernel.rs`
+//! around the application-shaped work, each recording the delta of
+//! `kernel::thm::probe_thm_count()` across the call. Deltas can nest (a β leg
+//! may re-enter the app rule), so the attributed ticks are an upper bound per
+//! row and rows must not be summed.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use kernel::Term;
+
+use crate::interp::Interp;
+
+pub struct Cell {
+    pub calls: AtomicU64,
+    pub ticks: AtomicU64,
+}
+
+impl Cell {
+    const fn new() -> Cell { Cell { calls: AtomicU64::new(0), ticks: AtomicU64::new(0) } }
+}
+
+pub static DPROD_APP: Cell = Cell::new();
+pub static COND_APP: Cell = Cell::new();
+pub static FS_APP: Cell = Cell::new();
+pub static APP_CONG: Cell = Cell::new();
+pub static BETA_EV: Cell = Cell::new();
+
+/// Run `f`, attributing the theorems it constructs to `cell`.
+pub fn scoped<T>(cell: &Cell, f: impl FnOnce() -> T) -> T {
+    let t0 = kernel::thm::probe_thm_count();
+    let out = f();
+    let dt = kernel::thm::probe_thm_count() - t0;
+    cell.calls.fetch_add(1, Ordering::Relaxed);
+    cell.ticks.fetch_add(dt, Ordering::Relaxed);
+    out
+}
+
+#[derive(Default)]
+struct Walk {
+    /// distinct nodes, by Rc address
+    seen: HashSet<usize>,
+    /// distinct nodes, by structure
+    structural: HashSet<Term>,
+    /// memoized tree size per address
+    tree_size: HashMap<usize, u128>,
+    /// DAG counts by kind
+    n_bound: u64,
+    n_free: u64,
+    n_app_watched: u64,
+    n_app_other: u64,
+    /// DAG count per symbol id (app-symbol excluded is fine to include)
+    by_sym: HashMap<u32, u64>,
+    /// watched-app nodes that occur as arg0 of a watched-app node
+    inner: HashSet<usize>,
+    /// all watched-app node addrs, with their chain depth
+    watched: HashMap<usize, u32>,
+    /// total tree nodes over all roots (with sharing expanded)
+    tree_total: u128,
+    roots: u64,
+}
+
+impl Walk {
+    fn add_root(&mut self, t: &Term, app_id: u32) {
+        self.roots += 1;
+        self.tree_total += self.visit(t, app_id);
+    }
+
+    /// Returns the tree size of `t`; fills DAG-level stats on first visit.
+    fn visit(&mut self, t: &Term, app_id: u32) -> u128 {
+        let addr = t.probe_addr();
+        if let Some(sz) = self.tree_size.get(&addr) {
+            return *sz
+        }
+        let mut size: u128 = 1;
+        if self.seen.insert(addr) {
+            self.structural.insert(t.clone());
+            match t.probe_app() {
+                Some((id, args)) => {
+                    if id == app_id {
+                        self.n_app_watched += 1;
+                        // chain depth through arg0
+                        let mut d = 1u32;
+                        let mut cur = args.first();
+                        while let Some(u) = cur {
+                            match u.probe_app() {
+                                Some((uid, uargs)) if uid == app_id => {
+                                    self.inner.insert(u.probe_addr());
+                                    d += 1;
+                                    cur = uargs.first();
+                                }
+                                _ => break,
+                            }
+                        }
+                        self.watched.insert(addr, d);
+                    } else {
+                        self.n_app_other += 1;
+                    }
+                    *self.by_sym.entry(id).or_default() += 1;
+                }
+                None => {
+                    if t.probe_kind() == 0 {
+                        self.n_bound += 1
+                    } else {
+                        self.n_free += 1
+                    }
+                }
+            }
+        }
+        if let Some((_, args)) = t.probe_app() {
+            for a in args {
+                size += self.visit(a, app_id);
+            }
+        }
+        self.tree_size.insert(addr, size);
+        size
+    }
+}
+
+fn walk_formula(w: &mut Walk, f: &kernel::Formula, app_id: u32) {
+    let (_, fs, ts) = f.probe_parts();
+    for t in ts {
+        w.add_root(t, app_id);
+    }
+    for g in fs {
+        walk_formula(w, g, app_id);
+    }
+}
+
+pub fn report(ip: &Interp) -> String {
+    use std::fmt::Write;
+    let app_id = ip.prelude.ap.app.id();
+    let mut out = String::new();
+    let mut w = Walk::default();
+    // Every stored constant: its denoting term, its typing conclusion, its
+    // defining equation's conclusion.
+    let keys = ip.const_keys();
+    let mut typed = 0u64;
+    for k in &keys {
+        let Some(c) = ip.get_const(k) else { continue };
+        w.add_root(&c.term, app_id);
+        if let Ok(s) = &c.typing {
+            typed += 1;
+            walk_formula(&mut w, s.thm().concl(), app_id);
+        }
+        if let Some(s) = &c.defeq {
+            walk_formula(&mut w, s.thm().concl(), app_id);
+        }
+    }
+    let dag = w.seen.len() as u64;
+    let napp = w.n_app_watched + w.n_app_other;
+    let _ = writeln!(out, "== termstats: stored context ({} consts, {typed} typed) ==", keys.len());
+    let _ = writeln!(out, "roots walked: {}", w.roots);
+    let _ = writeln!(out, "tree nodes (sharing expanded): {}", w.tree_total);
+    let _ = writeln!(out, "DAG nodes (distinct Rc): {dag}");
+    let _ = writeln!(out, "DAG nodes distinct by structure: {}", w.structural.len());
+    let _ = writeln!(
+        out,
+        "DAG kind split: bound {} free {} app-sym {} other-sym {}",
+        w.n_bound, w.n_free, w.n_app_watched, w.n_app_other
+    );
+    // spine stats: maximal watched nodes = watched not inner
+    let mut hist: HashMap<u32, u64> = HashMap::new();
+    for (addr, d) in &w.watched {
+        if !w.inner.contains(addr) {
+            *hist.entry(*d).or_default() += 1;
+        }
+    }
+    let total: u64 = hist.values().sum();
+    let _ = writeln!(out, "app spines in stored context (DAG-level, maximal): {total}");
+    let mut ls: Vec<_> = hist.into_iter().collect();
+    ls.sort();
+    for (l, c) in ls {
+        let _ = writeln!(out, "  len {l}: {c}");
+    }
+    // top symbols
+    let mut syms: Vec<_> = w.by_sym.iter().map(|(id, c)| (*c, *id)).collect();
+    syms.sort_unstable_by(|a, b| b.cmp(a));
+    let _ = writeln!(out, "top symbols by DAG count:");
+    for (c, id) in syms.iter().take(15) {
+        let label = ip
+            .sym_label_by_id(*id)
+            .unwrap_or(if *id == app_id { "app" } else { "?" });
+        let _ = writeln!(out, "  sym {id} ({label}): {c}");
+    }
+    // ── the parts registry: every distinct applicative term built via mk ──
+    {
+        let mut pw = Walk::default();
+        for t in ip.probe_parts_roots() {
+            pw.add_root(&t, app_id);
+        }
+        let pdag = pw.seen.len() as u64;
+        let _ = writeln!(out, "== termstats: parts registry (terms built via Interp::mk) ==");
+        let _ = writeln!(out, "registry roots: {}", pw.roots);
+        let _ = writeln!(out, "tree nodes (sharing expanded): {}", pw.tree_total);
+        let _ = writeln!(out, "DAG nodes (distinct Rc): {pdag}");
+        let _ = writeln!(out, "DAG nodes distinct by structure: {}", pw.structural.len());
+        let _ = writeln!(
+            out,
+            "DAG kind split: bound {} free {} app-sym {} other-sym {}",
+            pw.n_bound, pw.n_free, pw.n_app_watched, pw.n_app_other
+        );
+        let mut hist: HashMap<u32, u64> = HashMap::new();
+        for (addr, d) in &pw.watched {
+            if !pw.inner.contains(addr) {
+                *hist.entry(*d).or_default() += 1;
+            }
+        }
+        let ptotal: u64 = hist.values().sum();
+        let _ = writeln!(out, "app spines in parts registry (DAG-level, maximal): {ptotal}");
+        let mut ls: Vec<_> = hist.into_iter().collect();
+        ls.sort();
+        for (l, c) in ls {
+            let _ = writeln!(out, "  len {l}: {c}");
+        }
+    }
+    // allocation counters
+    let b = kernel::term::PROBE_NEW_BOUND.load(Ordering::Relaxed);
+    let f = kernel::term::PROBE_NEW_FREE.load(Ordering::Relaxed);
+    let a = kernel::term::PROBE_NEW_APP.load(Ordering::Relaxed);
+    let wa = kernel::term::PROBE_NEW_WATCHED.load(Ordering::Relaxed);
+    let _ = writeln!(out, "== allocation traffic (Term::new) ==");
+    let _ = writeln!(out, "bound {b} free {f} app-node {a}; of app-node, app-symbol {wa}");
+    let _ = writeln!(out, "watched-app depth histogram at allocation:");
+    let mut cum: Vec<u64> = Vec::new();
+    for (i, c) in kernel::term::PROBE_WATCHED_DEPTH.iter().enumerate() {
+        let v = c.load(Ordering::Relaxed);
+        cum.push(v);
+        if v > 0 {
+            let _ = writeln!(out, "  depth {}: {}", i + 1, v);
+        }
+    }
+    let est_all = kernel::term::probe_hll_estimate(&kernel::term::PROBE_HLL_ALL);
+    let est_app = kernel::term::probe_hll_estimate(&kernel::term::PROBE_HLL_WATCHED);
+    let _ = writeln!(out, "distinct structures over all allocations (HLL estimate): {est_all:.0}");
+    let _ = writeln!(out, "distinct structures over app-symbol allocations (HLL estimate): {est_app:.0}");
+    let _ = drop(cum);
+    // inference counters
+    let thms = kernel::thm::probe_thm_count();
+    let _ = writeln!(out, "== inference traffic (theorems constructed) ==");
+    let _ = writeln!(out, "total: {thms}");
+    for (name, cell) in [
+        ("dprod_app (app typing, dep)", &DPROD_APP),
+        ("cond_app  (app typing, prop)", &COND_APP),
+        ("fs_app    (app typing, fs)", &FS_APP),
+        ("app_cong  (conv congruence)", &APP_CONG),
+        ("beta_evidence (beta legs)", &BETA_EV),
+    ] {
+        let _ = writeln!(
+            out,
+            "{name}: calls {} ticks {}",
+            cell.calls.load(Ordering::Relaxed),
+            cell.ticks.load(Ordering::Relaxed)
+        );
+    }
+    out
+}
