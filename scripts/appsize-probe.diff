+// ═══════════════════════════════════════════════════════════════════════════
+// MEASUREMENT PROBE — appsize study, worktree-only, never to be landed.
+// Read-only views and allocation counters. Nothing here can build a Term or a
+// Formula, so the kernel's soundness story is untouched; it is still a patch
+// to the trusted base and exists only to be diffed away.
+// ═══════════════════════════════════════════════════════════════════════════
+
+use std::sync::atomic::{AtomicU64, AtomicU32, Ordering as AtOrd};
+
+/// Probe counter: `Bound` allocations.
+pub static PROBE_NEW_BOUND: AtomicU64 = AtomicU64::new(0);
+/// Probe counter: `Free` allocations.
+pub static PROBE_NEW_FREE: AtomicU64 = AtomicU64::new(0);
+/// Probe counter: `App` allocations.
+pub static PROBE_NEW_APP: AtomicU64 = AtomicU64::new(0);
+/// Allocations of `App` at the watched symbol (set by [`probe_watch_app`]).
+pub static PROBE_NEW_WATCHED: AtomicU64 = AtomicU64::new(0);
+/// Histogram of the watched symbol's arg0-chain depth at allocation time.
+pub static PROBE_WATCHED_DEPTH: [AtomicU64; 32] = {
+    #[allow(clippy::declare_interior_mutable_const)]
+    const Z: AtomicU64 = AtomicU64::new(0);
+    [Z; 32]
+};
+static PROBE_APP_SYM: AtomicU32 = AtomicU32::new(u32::MAX);
+
+/// Watch a symbol id: allocations of `App` with this id are counted and their
+/// spine depth (length of the chain of watched-id heads through argument 0)
+/// recorded.
+pub fn probe_watch_app(id: u32) { PROBE_APP_SYM.store(id, AtOrd::Relaxed); }
+
+impl Term {
+    /// `Some((symbol id, args))` when the node is an application.
+    pub fn probe_app(&self) -> Option<(u32, &[Term])> {
+        match self.data() {
+            TermData::App(f, args) => Some((f.id, args.as_slice())),
+            _ => None,
+        }
+    }
+
+    /// Which variant the node is: 0 bound, 1 free, 2 app.
+    pub fn probe_kind(&self) -> u8 {
+        match self.data() {
+            TermData::Bound(_) => 0,
+            TermData::Free(_) => 1,
+            TermData::App(..) => 2,
+        }
+    }
+
+    /// The `Rc` allocation address, for sharing statistics.
+    pub fn probe_addr(&self) -> usize { Rc::as_ptr(&self.data) as *const () as usize }
+
+    fn probe_note_new(data: &TermData) {
+        match data {
+            TermData::Bound(_) => { PROBE_NEW_BOUND.fetch_add(1, AtOrd::Relaxed); }
+            TermData::Free(_) => { PROBE_NEW_FREE.fetch_add(1, AtOrd::Relaxed); }
+            TermData::App(f, args) => {
+                PROBE_NEW_APP.fetch_add(1, AtOrd::Relaxed);
+                let w = PROBE_APP_SYM.load(AtOrd::Relaxed);
+                if f.id == w {
+                    PROBE_NEW_WATCHED.fetch_add(1, AtOrd::Relaxed);
+                    // arg0-chain depth: 1 + depth of the watched chain below.
+                    let mut d = 1usize;
+                    let mut cur = args.first();
+                    while let Some(t) = cur {
+                        match t.data() {
+                            TermData::App(g, gargs) if g.id == w => {
+                                d += 1;
+                                cur = gargs.first();
+                            }
+                            _ => break,
+                        }
+                    }
+                    let slot = d.min(PROBE_WATCHED_DEPTH.len()) - 1;
+                    PROBE_WATCHED_DEPTH[slot].fetch_add(1, AtOrd::Relaxed);
+                }
+            }
+        }
+    }
+}
+
+impl Formula {
+    /// Read-only structural view: variant tag, child formulas, child terms.
+    pub fn probe_parts(&self) -> (&'static str, Vec<&Formula>, Vec<&Term>) {
+        match self.data() {
+            FormulaData::False => ("false", vec![], vec![]),
+            FormulaData::Eq(a, b) => ("eq", vec![], vec![a, b]),
+            FormulaData::Mem(a, b) => ("mem", vec![], vec![a, b]),
+            FormulaData::Imp(a, b) => ("imp", vec![a, b], vec![]),
+            FormulaData::Forall(b) => ("forall", vec![b], vec![]),
+        }
+    }
+}
+
+/// Probe: HyperLogLog registers for distinct-structure estimation over all
+/// `Term::new` calls (by cached hash; the mixer is weak, so this is an
+/// estimate twice over and is reported as such).
+pub static PROBE_HLL_ALL: [core::sync::atomic::AtomicU8; 4096] = {
+    #[allow(clippy::declare_interior_mutable_const)]
+    const Z: core::sync::atomic::AtomicU8 = core::sync::atomic::AtomicU8::new(0);
+    [Z; 4096]
+};
+/// Probe: HLL registers over watched-symbol (`app`) allocations only.
+pub static PROBE_HLL_WATCHED: [core::sync::atomic::AtomicU8; 4096] = {
+    #[allow(clippy::declare_interior_mutable_const)]
+    const Z: core::sync::atomic::AtomicU8 = core::sync::atomic::AtomicU8::new(0);
+    [Z; 4096]
+};
+
+fn probe_hll_note(regs: &[core::sync::atomic::AtomicU8; 4096], h: u64) {
+    let idx = (h >> 52) as usize; // top 12 bits
+    let rest = h << 12;
+    let rank = (rest.leading_zeros() as u8).saturating_add(1).min(52);
+    let r = &regs[idx];
+    let mut cur = r.load(AtOrd::Relaxed);
+    while cur < rank {
+        match r.compare_exchange_weak(cur, rank, AtOrd::Relaxed, AtOrd::Relaxed) {
+            Ok(_) => break,
+            Err(c) => cur = c,
+        }
+    }
+}
+
+/// The HLL cardinality estimate for a register bank.
+pub fn probe_hll_estimate(regs: &[core::sync::atomic::AtomicU8; 4096]) -> f64 {
+    let m = 4096f64;
+    let mut sum = 0f64;
+    let mut zeros = 0u32;
+    for r in regs {
+        let v = r.load(AtOrd::Relaxed);
+        if v == 0 { zeros += 1 }
+        sum += 2f64.powi(-(v as i32));
+    }
+    let alpha = 0.7213 / (1.0 + 1.079 / m);
+    let e = alpha * m * m / sum;
+    if e <= 2.5 * m && zeros > 0 {
+        m * (m / zeros as f64).ln()
+    } else {
+        e
+    }
+}
