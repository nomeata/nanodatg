+/// The rules that appear anywhere in a recorded trace, as a sorted set.
+#[cfg(all(feature = "stepcount", feature = "tg"))]
+fn trace_rules<'t, C>(t: &TracePtr<'t, C>, out: &mut std::collections::BTreeSet<String>) {
+    let Some(t) = t else { return };
+    match &t.node {
+        Node::One(r) => {
+            out.insert(match r {
+                Rule::Beta => "β".to_string(),
+                Rule::Zeta => "ζ".to_string(),
+                Rule::Delta => "δ".to_string(),
+                Rule::Sort => "sort".to_string(),
+                Rule::Iota => "ι".to_string(),
+                Rule::ProjRed => "proj".to_string(),
+                Rule::Admitted(a) => format!("ADMIT:{}", a.name()),
+            });
+        }
+        Node::Seq(l, r) => {
+            trace_rules(&Some(l.clone()), out);
+            trace_rules(&Some(r.clone()), out);
+        }
+        Node::Cong(s) => {
+            out.insert("cong".to_string());
+            trace_rules(&Some(s.clone()), out);
+        }
+    }
+}
