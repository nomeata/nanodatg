+/// How many single steps a trace records.
+#[cfg(all(feature = "stepcount", feature = "tg"))]
+fn trace_len<'t, C>(t: &TracePtr<'t, C>) -> u64 {
+    match t {
+        None => 0,
+        Some(t) => match &t.node {
+            Node::One(_) => 1,
+            Node::Seq(l, r) => trace_len(&Some(l.clone())) + trace_len(&Some(r.clone())),
+            Node::Cong(s) => trace_len(&Some(s.clone())),
+        },
+    }
+}
