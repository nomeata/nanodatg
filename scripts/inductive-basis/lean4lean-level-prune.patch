-def isEquiv' (u v : Level) : Bool := u == v || Normalize.normalize u == Normalize.normalize v
+/-- NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM.  lean4lean's stock
+`isEquiv'`, preserved for measurement.  See the patch note above
+`Normalize.NormLevel.prune`. -/
+def isEquiv'Stock (u v : Level) : Bool := u == v || Normalize.normalize u == Normalize.normalize v
+
+/-- NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM.  `isEquiv'Stock`, but
+comparing pruned normal forms, so that information-free `NormLevel` entries
+left behind by `imax` paths do not block the comparison.  See the patch note
+above `Normalize.NormLevel.prune`. -/
+def isEquiv' (u v : Level) : Bool :=
+  u == v || (Normalize.normalize u).prune == (Normalize.normalize v).prune
 
 def isEquivList : List Level → List Level → Bool := List.all2 isEquiv'
 
-def geq' (u v : Level) : Bool := (Normalize.normalize v).le (Normalize.normalize u)
+/-- NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM.  lean4lean's stock
+`geq'`, preserved for measurement. -/
+def geq'Stock (u v : Level) : Bool := (Normalize.normalize v).le (Normalize.normalize u)
+
+/-- NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM.  `geq'Stock` routed
+through `NormLevel.prune`, for uniformity with `isEquiv'`.  `NormLevel.le`
+already skips information-free entries on both sides, so this is expected to
+agree with `geq'Stock` everywhere; see the patch note above
+`Normalize.NormLevel.prune`. -/
+def geq' (u v : Level) : Bool :=
+  (Normalize.normalize v).prune.le (Normalize.normalize u).prune
 
