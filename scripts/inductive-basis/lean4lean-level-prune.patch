+/-! ### NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM.
+`Lean4Lean/Level.lean` routes `isEquiv'` and `geq'` through
+`Normalize.NormLevel.prune`; see the patch note there.  These two lemmas carry
+`isEquiv'_wf` across that change: a pruned entry has `const = 0` and no
+variables, hence evaluates to `0`, hence pruning does not change
+`NormLevel.eval`.  This makes the *soundness* of the patched `isEquiv'` as
+verified as the stock one was; it says nothing about completeness. -/
+
+theorem Node.eval_of_isTrivial {l : Node} (h : l.isTrivial) : Node.eval ls ρ l = 0 := by
+  simp [Node.isTrivial] at h
+  simp [Node.eval, h.1, h.2]
+
+theorem NormLevel.get?_prune {l : NormLevel} {a : List Name} {b : Node} :
+    (NormLevel.prune l).get? a = some b ↔ l.get? a = some b ∧ b.isTrivial = false := by
+  simp [NormLevel.prune, Option.filter_eq_some_iff]
+
+theorem NormLevel.prune_eval {l : NormLevel} :
+    (NormLevel.prune l).eval ls ρ = l.eval ls ρ := by
+  refine Nat.le_antisymm (eval_le.2 fun a b h => ?_) (eval_le.2 fun a b h => ?_)
+  · exact eval_le.1 (Nat.le_refl _) a b (get?_prune.1 h).1
+  · by_cases hb : b.isTrivial
+    · simp [Node.eval_of_isTrivial hb, evalPath]
+    · exact eval_le.1 (Nat.le_refl _) a b (get?_prune.2 ⟨h, by simpa using hb⟩)
+
