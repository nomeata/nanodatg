index ea798f7..c81d8e2 100644
--- a/Lean4Lean/Level.lean
+++ b/Lean4Lean/Level.lean
@@ -152,6 +152,56 @@ def NormLevel.subsumption (acc : NormLevel) (paths := false) : NormLevel :=
 def normalize (l : Level) (paths := false) : NormLevel :=
   Normalize.normalizeAux l [] 0 (.insert {} [] default) |>.subsumption paths
 
+/-!
+### ===================================================================== ###
+### NANODATG LOCAL EXPERIMENTAL PATCH — NOT UPSTREAM, DO NOT PUSH         ###
+### ===================================================================== ###
+
+This block, and the `isEquiv'`/`geq'` block at the end of the file, are a
+**local experimental patch carried for nanodatg's `modelgen`**.  They are not
+part of lean4lean and have not been upstreamed.
+
+What it repairs: `Normalize.normalize` builds a `NormLevel`, a map from
+variable lists to `Node`s.  The root key `[]` is seeded with `default`, and
+`subsumption` empties (rather than erases) nodes it has fully subsumed — it
+sets `const := 0` and can drain `var` to `[]`.  A `vs => { const := 0,
+var := [] }` entry contributes `0` to the level, i.e. carries no information,
+but `instBEqNormLevel` compares maps entry-by-entry and so treats such an
+entry as distinguishing.  `imax` paths are what create these keys, so the
+observable symptom is that an `imax` is not absorbed into a `max` that
+dominates it — for instance
+    max 1 (imax (imax u v) v) (max 1 u v)   vs   max 1 u v
+which are equal at every assignment.  That is exactly the level identity
+`modelgen` needs for the `BoxF` carrier, and it is the reason the planner
+declines that shape.
+
+`NormLevel.prune` drops the information-free entries, and `isEquiv'`/`geq'`
+below both go through it.  `normalize'` deliberately does NOT: with
+`paths := true` the map must satisfy the invariant that every suffix of a
+`path` is present as a key, and `toTree`/`buildPaths` rely on it.
+
+Standing: lean4lean itself documents this path as experimental and incomplete
+in `divergences.md` — "an experimental new algorithm … intended to be complete
+for level algebra … currently known to be incomplete in cases where Lean's
+algorithm is not", with the plan of record being to verify Lean's original
+algorithm instead.  This patch is a measurement on a handful of level pairs,
+NOT a completeness proof, and it is NOT a licence for `modelgen` to emit a
+proof Lean's own kernel rejects.
+
+The stock definitions are preserved beside the patched ones as
+`isEquiv'Stock` and `geq'Stock`, so one binary can measure both.
+-/
+
+/-- A node that contributes nothing: `max` of the constant `0` and no
+variables.  See the NANODATG patch note above. -/
+def Node.isTrivial (n : Node) : Bool := n.const == 0 && n.var.isEmpty
+
+/-- Drop the information-free entries of a normal form.  See the NANODATG
+patch note above.  Not sound to use where the suffix-closure invariant on
+`path` is needed (i.e. before `toTree`). -/
+def NormLevel.prune (acc : NormLevel) : NormLevel :=
+  Std.TreeMap.filter (fun _ n => !n.isTrivial) acc
+
 def leVars : List VarNode → List VarNode → Bool
   | [], _ => true
   | _, [] => false
@@ -243,11 +293,31 @@ end Normalize
 
